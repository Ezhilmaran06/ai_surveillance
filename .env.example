# ==============================================================================
# SentinelVision AI — Environment Configuration Variables
# ==============================================================================

# Server Network Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Connection (SQLite default for local development)
DATABASE_URL=sqlite:///data/surveillance.db

# AI Inference & Computer Vision Models
# Supports: yolov8n.pt, yolov8s.pt, yolo11n.pt, or custom trained .pt files
MODEL_PATH=yolov8n.pt

# Neural Confidence & IoU Filter Thresholds
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Crowd Capacity & Safety Thresholds
MAX_CROWD_CAPACITY=20
MAX_DWELL_SECONDS=15
ALERT_COOLDOWN_SECONDS=5

# Spatial Physical Dimensions (for people / m² calculation)
MONITORED_AREA_M2=50.0

# Media Uploads & Ingestion
MAX_UPLOAD_SIZE_MB=250

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
